{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD028": false,
    "MD029": { "style": "ordered" },
    "MD036": false,
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD050": { "style": "asterisk" },
    "MD054": { "url_inline": false },
    "MD055": { "style": "leading_and_trailing" },
    "MD060": { "style": "aligned", "aligned_delimiter": true }
  },
  "overrides": [
    {
      "filter": ["AGENTS.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Repository Instructions",
            "## Tech Stack", "*",
            "## Repository Structure", "*",
            "## Setup and Commands", "*",
            "## Code Style", "*",
            "## Testing", "*",
            "## Commits and PRs", "*",
            "## Domain Knowledge", "*"
          ]
        }
      }
    },
    {
      "filter": ["CHANGELOG.md"],
      "combine": "merge",
      "config": {
        // Release headings accrue, so only the standing section is pinned
        "MD043": {
          "match_case": true,
          "headings": [
            "# Changelog",
            "*"
          ]
        }
      }
    },
    {
      "filter": ["CONTRIBUTING.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Contributing",
            "## Development", "*",
            "## Testing", "*"
          ]
        }
      }
    },
    {
      "filter": ["README.md"],
      "combine": "merge",
      "config": {
        // The logo, badges and title block are HTML; the heading they carry is an <h1>
        "MD033": {
          "allowed_elements": ["a", "b", "br", "div", "h1", "img", "p", "picture", "source", "details", "summary"]
        },
        "MD041": { "allow_preamble": true },
        "MD043": {
          "match_case": true,
          "headings": [
            "## Overview", "*",
            "## Installation", "*",
            "## Quick Start", "*",
            "## Configuration", "*",
            "## Metrics", "*",
            "## Examples", "*",
            "## Documentation", "*",
            "## Contributing", "*",
            "## License"
          ]
        }
      }
    },
    {
      "filter": ["SECURITY.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Security Policy",
            "## What to Include", "*",
            "## Exposure", "*",
            "## Endpoints", "*",
            "## Ingress Paths", "*",
            "## Egress Paths", "*",
            "## Out of Scope"
          ]
        }
      }
    },
    {
      "filter": ["docs/README.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Documentation",
            "## For Developers Docs", "*"
          ]
        }
      }
    },
    {
      "filter": ["docs/architecture.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Architecture",
            "## Scrape Path", "*",
            "## Endpoints", "*",
            "## Absence", "*",
            "## Metric Types", "*",
            "## Account Scope", "*",
            "## Dashboards"
          ]
        }
      }
    }
  ],
  "globs": ["**/*.md"],
  "gitignore": true,
  // Both are symlinks to AGENTS.md, which is linted on its own path
  "ignores": [".claude/CLAUDE.md", ".github/copilot-instructions.md"]
}
